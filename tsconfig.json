{
    "compileOnSave": false,
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "node",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "outDir": "./dist/out-tsc",
        "sourceMap": true,
        "declaration": false,
        "importHelpers": true,
        "types": [
            "node"
        ],
        "typeRoots": [
            "node_modules/@types"
        ],
        "baseUrl": "./",
        "paths": {},
        "skipLibCheck": true,
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "jsx": "react-jsx"
    },
    "include": [
        "src"
    ]
}